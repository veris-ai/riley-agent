# Bench image: the agent and nothing else. The bench's world twin provides
# Postgres (schema and rows) and hands this container DATABASE_URL; provider
# keys arrive from the bench's candidate env. Nothing is baked in.
FROM python:3.12-bookworm
ARG LIVEKIT_SERVER_VERSION=1.12.0

# The SFU runs beside the agent inside this one container, on localhost.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl ca-certificates tar \
    && curl -fsSL "https://github.com/livekit/livekit/releases/download/v${LIVEKIT_SERVER_VERSION}/livekit_${LIVEKIT_SERVER_VERSION}_linux_$(dpkg --print-architecture).tar.gz" \
        | tar -xz -C /usr/local/bin livekit-server \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /bin/
WORKDIR /agent
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY app ./app
COPY agent_desc.txt ./agent_desc.txt
COPY start.sh ./start.sh
RUN chmod +x ./start.sh

# Dev credentials for the in-container SFU only; it is reached over
# localhost and its port is not published.
ENV LIVEKIT_URL=ws://localhost:7880 \
    LIVEKIT_API_KEY=devkey \
    LIVEKIT_API_SECRET=secret \
    PYTHONUNBUFFERED=1
EXPOSE 8008
CMD ["bash", "/agent/start.sh"]
