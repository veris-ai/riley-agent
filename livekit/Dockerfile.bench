# Standalone image for the Veris benchmark BYO-candidate runner.
# Unlike Dockerfile.sandbox, this image doesn't rely on the simulation
# platform entrypoint: it owns its local Postgres and runs the three Riley
# processes (livekit-server SFU, the Agents worker, the voice_ws bridge on
# :8008) via start.sh, exactly as the sandbox image does.
FROM python:3.12-bookworm

ARG LIVEKIT_SERVER_VERSION=1.12.0
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        postgresql postgresql-client curl ca-certificates tar \
    && curl -fsSL "https://github.com/livekit/livekit/releases/download/v${LIVEKIT_SERVER_VERSION}/livekit_${LIVEKIT_SERVER_VERSION}_linux_$(dpkg --print-architecture).tar.gz" \
        | tar -xz -C /usr/local/bin livekit-server \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /bin/

WORKDIR /agent
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY app ./app
COPY agent_desc.txt ./agent_desc.txt
COPY db/init.sql ./db/init.sql
COPY start.sh ./start.sh
COPY docker/bench-entrypoint.sh /usr/local/bin/riley-bench-entrypoint
RUN chmod +x /usr/local/bin/riley-bench-entrypoint ./start.sh

ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veris \
    LIVEKIT_URL=ws://localhost:7880 \
    LIVEKIT_API_KEY=devkey \
    LIVEKIT_API_SECRET=secret \
    PYTHONUNBUFFERED=1

EXPOSE 8008
ENTRYPOINT ["/usr/local/bin/riley-bench-entrypoint"]
