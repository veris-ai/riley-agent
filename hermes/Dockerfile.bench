# Standalone image for the Veris benchmark BYO-candidate runner.
# Unlike Dockerfile.sandbox, this image doesn't rely on the simulation
# platform entrypoint: it owns its local Postgres and exposes Riley's
# voice_ws endpoint (:8008 /voice, /health) directly.
FROM python:3.12-bookworm

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        postgresql postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /bin/

WORKDIR /agent
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# hermes-agent (Nous) is installed from a pinned upstream commit into the same venv,
# exactly as .veris/Dockerfile.sandbox does.
ARG HERMES_AGENT_COMMIT=863e31318553cda8ad61df681d08175364d4164b
ADD https://github.com/NousResearch/hermes-agent/archive/${HERMES_AGENT_COMMIT}.tar.gz /tmp/hermes-agent.tar.gz
RUN tar -xzf /tmp/hermes-agent.tar.gz -C /opt \
    && mv /opt/hermes-agent-${HERMES_AGENT_COMMIT} /opt/hermes-agent \
    && rm /tmp/hermes-agent.tar.gz \
    && uv pip install -p /agent/.venv -e /opt/hermes-agent

COPY app ./app
COPY hermes_home ./hermes_home
COPY agent_desc.txt ./agent_desc.txt
COPY db/init.sql ./db/init.sql
COPY docker/bench-entrypoint.sh /usr/local/bin/riley-bench-entrypoint
RUN chmod +x /usr/local/bin/riley-bench-entrypoint

ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veris \
    PYTHONUNBUFFERED=1

EXPOSE 8008
ENTRYPOINT ["/usr/local/bin/riley-bench-entrypoint"]
